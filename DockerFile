FROM node:20-alpine

WORKDIR /app

# Copy root package.json
COPY package*.json ./
RUN npm install

# Copy semua source code (node_modules tidak ikut karena .dockerignore)
COPY . .

# Install dependencies tiap service di dalam container
RUN cd service-dapur && npm install
RUN cd service-distribusi && npm install
RUN cd service-inventory && npm install
RUN cd service-menu && npm install
RUN cd service-sekolah && npm install

EXPOSE 8080

CMD ["node", "server.js"]